# Copier ce fichier vers .env et remplir les valeurs réelles. .env ne doit JAMAIS être commité.

# Base de données Postgres dédiée à ANNONCES (locale, via docker-compose).
# Instance totalement isolée de card-tracker ou de tout autre projet.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=annonces
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=changeme_admin

# Rôle applicatif utilisé par la credential Postgres de n8n.
N8N_APP_PASSWORD=changeme_n8n

# Rôle applicatif utilisé par la connexion DB de Metabase.
METABASE_APP_PASSWORD=changeme_metabase

# Adresse d'écoute de n8n. Par défaut 127.0.0.1 (accès local/tunnel SSH
# uniquement). Sur le VPS, mettre l'IP de l'interface Tailscale pour un
# accès permanent depuis les autres appareils du tailnet sans exposer
# n8n sur l'interface publique.
N8N_LISTEN_ADDRESS=127.0.0.1

# Clés des API sources, lues par le conteneur n8n via des expressions
# {{ $env.VAR }} dans les nodes "Adzuna Search", "Jooble Search" et
# "Traduction Deepl" — jamais écrites en dur dans les paramètres des nodes,
# pour ne plus apparaître en clair dans un export de workflow.
ADZUNA_APP_ID=changeme_adzuna_app_id
ADZUNA_API_KEY=changeme_adzuna_api_key
JOOBLE_API_KEY=changeme_jooble_api_key
DEEPL_API_KEY=changeme_deepl_api_key

# Jeton API Apify (console.apify.com > Settings > Integrations), lu par le
# node "Indeed Search" pour appeler l'acteur misceres/indeed-scraper.
APIFY_API_KEY=changeme_apify_api_key

# Adresse d'expéditeur/destinataire du digest, lue par les nodes "Send Email"
# via {{ $env.DIGEST_EMAIL }} — jamais écrite en dur dans les workflows.
DIGEST_EMAIL=changeme@example.com
